#!/bin/sh

version_number="1.0.0"

# UI

# shellcheck disable=SC2086
# $1 = prompt, $2 = multi select flag (for fzf/rofi), $3 = extra flags by user
menu() {
    case "$menu_program" in
        fzf) fzf --reverse --cycle --prompt "$1" $2 $3 ;;
        rofi) rofi -sort -dmenu -i -p "$1" $2 $3 ;;
        dmenu) dmenu -l 20 -p "$1" $3 ;;
        *) "$menu_program" $3 "$1" ;;
    esac
}

# provide menu. input format is either (ep_list) or (number \t anime_id \t anime_name)
nth() {
    _stdin=$(cat -)
    [ -z "$_stdin" ] && return 1
    _line_count="$(printf "%s\n" "$_stdin" | wc -l | tr -d "[:space:]")"
    [ "$_line_count" -eq 1 ] && printf "%s" "$_stdin" | cut -f 2,3 && return 0
    _prompt="$1"
    [ $# -ne 1 ] && _multi_flag="$2"
    _line=$(printf "%s" "$_stdin" | cut -f 1,3 | tr '\t' ' ' | menu "$_prompt" "$_multi_flag" "$menu_extra_flags" | cut -d " " -f 1)
    _line_start=$(printf "%s" "$_line" | head -n 1)
    _line_end=$(printf "%s" "$_line" | tail -n 1)
    [ -n "$_line" ] || return 1
    if [ "$_line_start" = "$_line_end" ]; then
        printf "%s" "$_stdin" | grep -E '^'"${_line}"'($|[[:space:]])' | cut -f 2,3 || return 1
    else
        printf "%s" "$_stdin" | sed -n '/^'"${_line_start}"'$/,/^'"${_line_end}$"'/p' || return 1
    fi
}

die() {
    printf "\33[2K\r\033[1;31m%s\033[0m\n" "$*" >&2
    exit 1
}

info() {
    printf "\33[2K\r\033[1;34m%s\033[0m\n" "$*"
}

help_info() {
    printf "
    Usage:
    %s [options] [query]
    %s [query] [options]
    %s [options] [query] [options]

    Options:
      -c, --continue
        Continue watching from history
      -d, --download
        Download the video instead of playing it
      -D, --delete
        Delete history
      -l, --logview
        Show logs
      -s, --syncplay
        Use Syncplay to watch with friends
      -S, --select-nth
        Select nth entry
      -q, --quality
        Specify the video quality
      -v, --vlc
        Use VLC to play the video
      -V, --version
        Show the version of the script
      -h, --help
        Show this help message and exit
      -e, --episode, -r, --range
        Specify the number of episodes to watch
      --dub
        Play dubbed version
      --rofi
        Use rofi instead of fzf for the interactive menu
      --dmenu
        Use dmenu instead of fzf for the interactive menu
      --skip
        Use ani-skip to skip the intro of the episode (mpv only)
      --no-detach
        Don't detach the player (useful for in-terminal playback, mpv only)
      --exit-after-play
        Exit the player, and return the player exit code (useful for non interactive scenarios)
      -N, --nextep-countdown
        Display a countdown to the next episode
    Some example usages:
      %s -q 720p banana fish
      %s --skip -S 2 one piece
      %s -d -e 2 cyberpunk edgerunners
      %s --vlc cyberpunk edgerunners -q 1080p -e 4
      %s blue lock -e 5-6
      %s -e \"5 6\" blue lock
    \n" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}"
    exit 0
}

version_info() {
    printf "%s\n" "$version_number"
    exit 0
}

# Bookkeeping


# checks if dependencies are present
dep_ch() {
    command -v "$1" >/dev/null || die "Program $1 not found. Please install it."
}

# checks for deps in order and returns the first available. format is "prog_a,prog_b,prog_c"
dep_ch_failover() {
    [ -z "$1" ] && return 1
    prog=$(printf "%s" "$1" | cut -d "," -f 1)
    rest=$(printf "%s" "$1" | cut -s -d "," -f 2-)
    command -v "$prog" >/dev/null 2>&1 && printf "%s" "$prog" && return 0
    [ -e "$prog" ] && printf "%s" "$prog" && return 0
    dep_ch_failover "$rest"
}

stop_relay() {
    [ -z "$relay_pid" ] || kill "$relay_pid" 2>/dev/null
    [ -z "$relay_pid" ] || wait "$relay_pid" 2>/dev/null
    unset relay_pid
}

wait_for_player() {
    [ -z "$player_pid" ] && return 0
    wait "$player_pid" 2>/dev/null || :
    unset player_pid
    stop_relay
}

cleanup() {
    [ "$cleanup_done" = 1 ] && return
    cleanup_done=1
    tput sgr0 >/dev/null 2>&1 || :
    stop_relay
    rm -f "${histfile}.new" "$relay_file" "$subtitle_file" "$subtitle_vlc_file" # remove temp files
}
load_subtitle_settings() {
    subtitle_enabled="${YOMI_CLI_SUBTITLES:-1}"
    subtitle_language="${YOMI_CLI_SUBTITLE_LANGUAGE:-English}"
    [ -f "$settings_file" ] || return 0
    while IFS='=' read -r _key _value; do
        case "$_key" in
            enabled)
                case "$_value" in
                    0 | 1) subtitle_enabled=$_value ;;
                esac
                ;;
            language) [ -n "$_value" ] && subtitle_language=$_value ;;
        esac
    done <"$settings_file"
}

save_subtitle_settings() {
    {
        printf "enabled=%s\n" "$subtitle_enabled"
        printf "language=%s\n" "$subtitle_language"
    } >"$settings_file"
}

choose_subtitles() {
    _subtitle_choices="off"
    [ -z "$subtitle_options" ] || _subtitle_choices="off
$(
        printf "%s\n" "$subtitle_options" | cut -f 1
    )"
    _subtitle_choice="$(printf "%s\n" "$_subtitle_choices" | menu "Subtitles: " "" "$menu_extra_flags")"
    [ -z "$_subtitle_choice" ] && return 0
    if [ "$_subtitle_choice" = "off" ]; then
        subtitle_enabled=0
    else
        subtitle_enabled=1
        subtitle_language=$_subtitle_choice
    fi
    save_subtitle_settings
}

start_relay() {
    [ "$player_function" = "debug" ] && return 0
    command -v python3 >/dev/null 2>&1 || return 0
    [ -f "$relay_script" ] || return 0
    rm -f "$relay_file"
    if [ -n "$2" ]; then
        python3 "$relay_script" "$1" "$2" >"$relay_file" 2>/dev/null &
    else
        python3 "$relay_script" "$1" >"$relay_file" 2>/dev/null &
    fi
    relay_pid=$!
    _attempt=0
    while [ ! -s "$relay_file" ] && [ "$_attempt" -lt 20 ]; do
        sleep 0.1
        _attempt=$((_attempt + 1))
    done
    if [ -s "$relay_file" ]; then
        video_link="$(sed -n '1p' "$relay_file")"
        [ -z "$2" ] || subtitle_link="$(sed -n '2p' "$relay_file")"
    else
        kill "$relay_pid" 2>/dev/null
        wait "$relay_pid" 2>/dev/null
        unset relay_pid
    fi
}

# SCRAPING

#shellcheck disable=SC2086
yomi_curl() {
    _referer="${2:-$base_api/}"
    _response="$($curl_exe -sL -A "$agent" -e "$_referer" -H 'X-Requested-With: XMLHttpRequest' --max-time 15 $cipher_flag -w ' %{http_code}' "$1")" ||
        die "Connection error: could not fetch $1 (curl exit $?)"
    _http_code=${_response##* }
    _response=${_response% *}
    case "$_http_code" in
        2??) ;;
        *) die "Request failed: HTTP $_http_code from $1" ;;
    esac
    printf "%s" "$_response"
}

# search AniList metadata for Yomi's MAL-backed routes. format is (id \t name)
yomi_search() {
    _query="$(printf "%s" "$1" | sed 's|+| |g;s|\\|\\\\|g;s|"|\\"|g')"
    _payload='{"query":"query ($search: String) { Page(perPage: 25) { media(search: $search, type: ANIME) { id title { romaji english } } } }","variables":{"search":"'"$_query"'"}}'
    _response="$($curl_exe -sL -A "$agent" -e "$base_api/" -H 'Origin: https://yomi.to' -H 'Content-Type: application/json' -H 'Accept: application/json' -d "$_payload" "$metadata_api")" ||
        die "Connection error: could not fetch $metadata_api"
    printf "%s" "$_response" | jq -r '.data.Page.media[] | [.id, (.title.english // .title.romaji)] | @tsv' |
        while IFS="$(printf '\t')" read -r _mal_id _title; do
            _slug="$(printf "%s" "$_title" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g;s/^-+//;s/-+$//')"
            printf "%s-%s\t%s\n" "$_slug" "$_mal_id" "$_title"
        done
}

# resolve Yomi's AniList slug to the MAL id used by MegaPlay
yomi_desc() {
    _anilist_id="$(printf "%s" "$1" | sed -nE 's|.*-([0-9]+)$|\1|p')"
    _payload='{"query":"query ($id: Int) { Media(id: $id, type: ANIME) { idMal } }","variables":{"id":'"$_anilist_id"'}}'
    _response="$($curl_exe -sL -A "$agent" -e "$base_api/" -H 'Origin: https://yomi.to' -H 'Content-Type: application/json' -H 'Accept: application/json' -d "$_payload" "$metadata_api")" ||
        die "Connection error: could not fetch $metadata_api"
    mal_id="$(printf "%s" "$_response" | jq -r '.data.Media.idMal // 0')"
    [ "$mal_id" -gt 0 ] 2>/dev/null || mal_id="$_anilist_id"
    unset seasons seasons_option
}

# get the available episode list from AniList. Airing series may not publish
# a total episode count; nextAiringEpisode then identifies the released count.
yomi_episodes() {
    _anilist_id="$(printf "%s" "$1" | sed -nE 's|.*-([0-9]+)$|\1|p')"
    _payload='{"query":"query ($id: Int) { Media(id: $id, type: ANIME) { episodes nextAiringEpisode { episode } } }","variables":{"id":'"$_anilist_id"'}}'
    _response="$($curl_exe -sL -A "$agent" -e "$base_api/" -H 'Origin: https://yomi.to' -H 'Content-Type: application/json' -H 'Accept: application/json' -d "$_payload" "$metadata_api")" ||
        die "Connection error: could not fetch $metadata_api"
    _count="$(printf "%s" "$_response" | jq -r '.data.Media.episodes // 0')"
    case "$_count" in
        '' | 0 | null)
            _next_episode="$(printf "%s" "$_response" | jq -r '.data.Media.nextAiringEpisode.episode // 0')"
            case "$_next_episode" in
                '' | 0 | null | *[!0-9]*) return 1 ;;
                *) _count=$((_next_episode - 1)) ;;
            esac
            ;;
        *[!0-9]*) return 1 ;;
    esac
    [ "$_count" -gt 0 ] 2>/dev/null || return 1
    seq "$_count" | while read -r _ep; do
        printf "%s\t%s\n" "$1" "$_ep"
    done
}

# resolve the Yomi watch page through MegaPlay to a direct HLS master playlist
yomi_m3u8() {
    _watch_url="$(printf "$watch_api" "$anime_id" "$1")"
    _embed="https://megaplay.buzz/stream/mal/${mal_id}/${1}/${2}"
    [ -z "$_embed" ] && return 1

    _embed_page="$(yomi_curl "$_embed" "$_watch_url")" || return 1
    _file_id="$(printf "%s" "$_embed_page" | sed -nE 's|.*<title>File ([0-9]+) - MegaPlay</title>.*|\1|p')"
    [ -z "$_file_id" ] && return 1

    _source_page="$(yomi_curl "$(printf "$source_api" "$_file_id")" "$_embed")" || return 1
    : >"$subtitle_file"
    printf "%s" "$_source_page" |
        jq -r '.tracks[]? | select(.file? and ((.kind // "captions") | test("caption|subtitle"; "i"))) | [(.label // "English"), .file] | @tsv' >"$subtitle_file"
    _m3u8_master="$(
        printf "%s" "$_source_page" |
            jq -r '(if (.sources | type) == "object" then .sources.file elif (.sources | type) == "array" then .sources[0].file else .file end) // empty' 2>/dev/null
    )"
    if [ -z "$_m3u8_master" ]; then
        _encoded="$(printf "%s" "$_source_page" | jq -r '.enc // empty' 2>/dev/null)"
        [ -n "$_encoded" ] || return 1
        case $((${#_encoded} % 4)) in
            1) return 1 ;;
            2) _encoded="${_encoded}==" ;;
            3) _encoded="${_encoded}=" ;;
        esac
        command -v openssl >/dev/null 2>&1 || die "Program openssl not found. Please install it."
        _m3u8_master="$(
            printf "%s" "$_encoded" |
                tr '_-' '/+' |
                openssl enc -d -aes-256-cbc -a -A \
                    -K 693f4c4d5441783051362c3a7d353055000000000000000000000000000000 \
                    -iv 57303b3237546f6155706c5f50252763 2>/dev/null |
                jq -r '.file // empty' 2>/dev/null
        )"
    fi
    [ -n "$_m3u8_master" ] || return 1
    _source_key="$(printf "%s" "$_m3u8_master" | sed -nE 's|.*/([a-fA-F0-9]{32})/([a-fA-F0-9]{32})/.*|\1/\2|p' | tr '[:upper:]' '[:lower:]')"
    if [ -n "$_source_key" ]; then
        command -v python3 >/dev/null 2>&1 || die "Program python3 not found. Please install it."
        _token="$(python3 -c 'import base64, hashlib, hmac, sys, time; message=("%d|%s" % (int(time.time()) + 90, sys.argv[1])).encode(); b=lambda value:base64.urlsafe_b64encode(value).decode().rstrip("="); print(b(message)+"."+b(hmac.new(b"MpCdnT0k3n!9f2K#xQ7vL5mR8wN1pY4s", message, hashlib.sha256).digest()))' "$_source_key")" || return 1
        case "$_m3u8_master" in
            *\?*) _m3u8_master="${_m3u8_master}&token=$_token" ;;
            *) _m3u8_master="${_m3u8_master}?token=$_token" ;;
        esac
    fi
    _master_page="$(yomi_curl "$_m3u8_master" "https://megaplay.buzz/")" || return 1
    _master_dir=${_m3u8_master%/*}
    _links="$(printf "%s" "$_master_page" | sed -nE '
        /^#EXT-X-STREAM-INF/ {
            N
            s/^#EXT-X-STREAM-INF:.*RESOLUTION=[0-9]+x([0-9]+).*\n(.*)$/\1 > \2/p;
        }')"
    [ -n "$_links" ] || _links="best > $_m3u8_master"
    printf "%s\n" "$_links" | while IFS=' >' read -r _height _variant; do
        case "$_variant" in
            http://* | https://*) ;;
            *) _variant="$_master_dir/$_variant" ;;
        esac
        printf "%sp > %s\n" "$_height" "$_variant"
    done
}

# select the quality according to the setting
select_quality() {
    case "$1" in
        best) _result=$(printf "%s" "$links" | head -n 1) ;;
        worst) _result=$(printf "%s" "$links" | grep -E '^[0-9]{3,4}' | tail -n 1) ;;
        *) _result=$(printf "%s" "$links" | grep -m 1 "$1") ;;
    esac
    [ -z "$_result" ] && printf "\33[2K\r\033[1;33m%s\033[0m\n" "$1 not found, defaulting to best" >&2 && _result=$(printf "%s" "$links" | head -n 1)

    video_link=$(printf "%s" "$_result" | cut -d ">" -f 2 | sed 's|^ *||')
}

# gets the direct HLS links and selects one with desired quality
get_video_link() {
    links=$(yomi_m3u8 "$ep_no" "$mode" | sort -g -r -s)
    [ -z "$links" ] && die "No sources found for $mode!"
    subtitle_options=$(cat "$subtitle_file" 2>/dev/null)
    subtitle_link=
    if [ "$subtitle_enabled" = 1 ] && [ -n "$subtitle_options" ]; then
        _subtitle_fallback=
        while IFS='	' read -r _subtitle_label _subtitle_url; do
            [ -n "$_subtitle_fallback" ] || _subtitle_fallback=$_subtitle_url
            if [ "$_subtitle_label" = "$subtitle_language" ]; then
                subtitle_link=$_subtitle_url
                break
            fi
            [ -n "$subtitle_link" ] || [ "$_subtitle_label" = "English" ] && subtitle_link=$_subtitle_url
        done <<EOF
$subtitle_options
EOF
        [ -n "$subtitle_link" ] || subtitle_link=$_subtitle_fallback
    fi
    info "yomi.to links fetched"
    select_quality "$quality"
    # should never trigger but just in case
    if printf "%s" "$ep_list" | grep -q "^$ep_no$"; then
        [ -z "$video_link" ] && die "Episode is released, but no valid sources!"
    else
        [ -z "$video_link" ] && die "Episode not released!"
    fi
}

# provide countdown for the next episode release both sub and dub
time_until_next_ep() {
    animeschedule="https://animeschedule.net"
    _query="$(printf "%s" "$*" | tr ' ' '+')"
    $curl_exe -s -G "$animeschedule/api/v3/anime" --data "q=${_query}" | sed 's|},{"id"|\n|g' | while read -r _entry; do
        _route=$(printf "%s" "$_entry" | sed -nE 's|.*"route":"([^"]*)",.*|\1|p')
        _eng_title=$(printf '%s' "$_entry" | sed -nE 's|.*"english":"([^"]*)".*|\1|p')
        [ -z "$_eng_title" ] && _eng_title=$(printf '%s' "$_entry" | sed -nE 's|.*,"title":"([^"]*)".*|\1|p')
        [ -z "$_eng_title" ] && _eng_title="N/A"
        _jpn_title=$(printf '%s' "$_entry" | sed -nE 's|.*"romaji":"([^"]*)".*|\1|p')
        [ -z "$_jpn_title" ] && _jpn_title="N/A"
        _status=$(printf '%s' "$_entry" | sed -nE 's|.*"status":"([^"]*)".*|\1|p')
        [ -z "$_status" ] && _status="Unknown"

        case "$_status" in
            Ongoing) _color="33" ;;
            Finished) _color="32" ;;
            *) _color="36" ;;
        esac

        printf "Eng: %s\n" "$_eng_title"
        printf "Jpn: %s\n" "$_jpn_title"
        printf "Status: \033[1;%sm%s\033[0m\n" "$_color" "$_status"

        if [ "$_status" != "Finished" ]; then
            _page="$($curl_exe -s "$animeschedule/anime/$_route")"
            _sub_ep=$(printf "%s" "$_page" | sed -nE 's|.*release-time-type-subs"[^>]*><span class="release-time-episode-number">Episode ([0-9]+)</span>.*|\1|p' | head -n 1)
            _dub_ep=$(printf "%s" "$_page" | sed -nE 's|.*release-time-type-dub"[^>]*><span class="release-time-episode-number">Episode ([0-9]+)</span>.*|\1|p' | head -n 1)
            _sub_countdown=$(printf "%s" "$_page" | sed -nE 's|.*class="countdown-time" datetime="([^"]*)".*|\1|p' | head -n 1)
            _dub_countdown=$(printf "%s" "$_page" | sed -nE 's|.*class="countdown-time countdown-time-dub" datetime="([^"]*)".*|\1|p' | head -n 1)

            [ -n "$_sub_ep" ] && [ -n "$_sub_countdown" ] &&
                printf "Next Sub: Episode %s in \033[1;%sm%s\033[0m\n" "$_sub_ep" "$_color" "$_sub_countdown" || printf "Next Sub: N/A\n"
            [ -n "$_dub_ep" ] && [ -n "$_dub_countdown" ] &&
                printf "Next Dub: Episode %s in \033[1;%sm%s\033[0m\n" "$_dub_ep" "$_color" "$_dub_countdown" || printf "Next Dub: N/A\n"
        fi
        printf "\n"
    done
    exit 0
}

# HISTORY

backup_old_hist() {
    backupfile="${histfile}.v4"
    while IFS="	" read -r ep_no anime_id anime_title; do
        case "$anime_id" in
            *-*) printf "%s\t%s\t%s\n" "$ep_no" "$anime_id" "$anime_title" >>"${histfile}.new" ;;
            *) printf "%s\t%s\t%s\n" "$ep_no" "$anime_id" "$anime_title" >>"$backupfile" ;;
        esac
    done <"$histfile"
    mv "${histfile}.new" "$histfile"
}

process_hist_entry() {
    ep_list=$(yomi_episodes "$anime_id" | cut -f 2)
    ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}") 2>/dev/null
    [ -n "$ep_no" ] && printf "%s\t%s - episode %s\n" "$anime_id" "$anime_title" "$ep_no"
}

update_history() {
    if grep -q "	${anime_id}	" "$histfile"; then
        # escape sed special chars in replacement: & and \ and delimiter |
        safe_title=$(printf "%s" "$anime_title" | sed 's|[&\|]|\\&|g')
        sed -E "s|^[^	]+	${anime_id}	[^	]+$|${ep_no}	${anime_id}	${safe_title}|" "$histfile" >"${histfile}.new"
    else
        cp "$histfile" "${histfile}.new"
        printf "%s\t%s\t%s\n" "$ep_no" "$anime_id" "$anime_title" >>"${histfile}.new"
    fi
    mv "${histfile}.new" "$histfile"
}

# PLAYING

# shellcheck disable=SC2086
# $1 = video link, $2 = video name, $3 = extra flags
download() {
    command -v "yt-dlp" >/dev/null && yt-dlp --referer "https://megaplay.buzz/" "$1" --no-skip-unavailable-fragments --fragment-retries infinite -N 16 -o "$download_dir/$2.mp4" $3 && return 0
    ffmpeg -extension_picky 0 -loglevel error -stats -headers "Referer: https://megaplay.buzz/\r\n" -i "$1" -c copy "$download_dir/$2.mp4" $3
}

play_episode() {
    [ "$log_episode" = 1 ] && [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && command -v logger >/dev/null && logger -t yomi-cli "${anime_title} ${ep_no}"
    [ "$skip_intro" = 1 ] && skip_flag="$(ani-skip -i "$mal_id" -e "$canon_ep_no")"
    # Menu actions are queued until the current player exits.
    wait_for_player
    [ -z "$video_link" ] && get_video_link
    start_relay "$video_link" "$subtitle_link"
    subtitle_player_flag=
    if [ "$subtitle_enabled" = 1 ] && [ -n "$subtitle_link" ]; then
        case "$player_function" in
            *vlc*)
                if $curl_exe -sL -A "$agent" -e "https://megaplay.buzz/" --max-time 15 "$subtitle_link" >"$subtitle_vlc_file" &&
                    grep -q "WEBVTT" "$subtitle_vlc_file"; then
                    subtitle_player_flag="--sub-file=$subtitle_vlc_file"
                else
                    rm -f "$subtitle_vlc_file"
                fi
                ;;
            *) subtitle_player_flag="--sub-file=$subtitle_link" ;;
        esac
    fi
    # shellcheck disable=SC2086
    case "$player_function" in
        debug) printf "All links:\n%s\nSelected link:\n%s\nSubtitle:\n%s\n" "$links" "$video_link" "${subtitle_link:-off}" ;;
        android_mpv)
            nohup am start --user 0 -a android.intent.action.VIEW -d "$video_link" -n is.xyz.mpv/.MPVActivity -e "title" "${anime_title} Episode ${ep_no}" $player_extra_flags >/dev/null 2>&1 &
            player_pid=$!
            ;;
        android_vlc)
            nohup am start --user 0 -a android.intent.action.VIEW -d "$video_link" -n org.videolan.vlc/org.videolan.vlc.gui.video.VideoPlayerActivity -e "title" "${anime_title} Episode ${ep_no}" $player_extra_flags >/dev/null 2>&1 &
            player_pid=$!
            ;;
        *flatpak*mpv*)
            flatpak run io.mpv.Mpv $skip_flag $player_extra_flags $subtitle_player_flag --http-header-fields="Referer: https://megaplay.buzz/" --force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 &
            player_pid=$!
            ;;
        *mpv*)
            if [ "$no_detach" = 0 ]; then
                nohup $player_function $skip_flag $player_extra_flags $subtitle_player_flag --http-header-fields="Referer: https://megaplay.buzz/" --force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 &
                player_pid=$!
            else
                $player_function $skip_flag $player_extra_flags $subtitle_player_flag --http-header-fields="Referer: https://megaplay.buzz/" --force-media-title="${anime_title} Episode ${ep_no}" "$video_link"
                mpv_exitcode=$?
                [ "$exit_after_play" = 1 ] && [ -z "$_range" ] && exit "$mpv_exitcode"
            fi
            ;;
        *iina*)
            if pgrep -f "IINA" >/dev/null 2>&1; then
                # omit --keep-running when an IINA instance exists to prevent hanging
                nohup $player_function $player_extra_flags --no-stdin $subtitle_player_flag --mpv-force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 &
            else
                nohup $player_function $player_extra_flags --no-stdin --keep-running $subtitle_player_flag --mpv-force-media-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 &
            fi
            player_pid=$!
            ;;
        *vlc*)
            nohup $player_function $player_extra_flags $subtitle_player_flag --http-referrer=https://megaplay.buzz/ --play-and-exit --meta-title="${anime_title} Episode ${ep_no}" "$video_link" >/dev/null 2>&1 &
            player_pid=$!
            ;;
        *yncpla*)
            nohup $player_function $player_extra_flags $subtitle_player_flag "$video_link" -- --force-media-title="${anime_title} Episode ${ep_no}" >/dev/null 2>&1 &
            player_pid=$!
            ;;
        download) "$player_function" "$video_link" "${anime_title} Episode ${ep_no}" $player_extra_flags ;;
        catt)
            nohup catt cast $player_extra_flags "$video_link" >/dev/null 2>&1 &
            player_pid=$!
            ;;
        iSH)
            printf "\033]8;;vlc://%s\a~~~~~~~~~~~~~~~~~~~~\n~ Tap to open VLC ~\n~~~~~~~~~~~~~~~~~~~~\033]8;;\a\n" "$video_link"
            sleep 5
            ;;
        *)
            nohup $player_function $player_extra_flags $subtitle_player_flag "$video_link" >/dev/null 2>&1 &
            player_pid=$!
            ;;
    esac
    replay="$video_link"
    unset video_link
    update_history
    [ "$menu_program" != "fzf" ] && wait_for_player
}

play() {
    _start=$(printf "%s" "$ep_no" | grep -Eo '^(-1|[0-9]+(\.[0-9]+)?)')
    _end=$(printf "%s" "$ep_no" | grep -Eo '(-1|[0-9]+(\.[0-9]+)?)$')
    [ "$_start" = "-1" ] && ep_no=$(printf "%s" "$ep_list" | tail -n 1) && unset _start
    [ -z "$_end" ] || [ "$_end" = "$_start" ] && unset _start _end
    [ "$_start" = "0" ] && _start=$(printf "%s" "$ep_list" | head -n 1)
    [ "$_end" = "-1" ] && _end=$(printf "%s" "$ep_list" | tail -n 1)
    _line_count=$(printf "%s\n" "$ep_no" | wc -l | tr -d "[:space:]")
    if [ "$_line_count" != 1 ] || [ -n "$_start" ]; then
        [ -z "$_start" ] && _start=$(printf "%s\n" "$ep_no" | head -n 1)
        [ -z "$_end" ] && _end=$(printf "%s\n" "$ep_no" | tail -n 1)
        _range=$(printf "%s\n" "$ep_list" | sed -nE "/^${_start}\$/,/^${_end}\$/p")
        [ -z "$_range" ] && die "Invalid range!"
        for i in $_range; do
            tput clear
            ep_no=$i
            canon_ep_no="$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/=")"
            info "Playing episode $ep_no..."
            [ "$i" = "$_end" ] && unset _range
            play_episode
        done
    else
        printf "%s" "$ep_list" | grep -q "^$ep_no$" || die "Invalid episode!"
        canon_ep_no="$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/=")"
        play_episode
    fi
    # moves up to stored position and deletes to end
    [ "$player_function" != "debug" ] && [ "$player_function" != "download" ] && tput rc && tput ed
}

